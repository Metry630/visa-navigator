    {
      "id": "fair-consideration",
      "kind": "manual",
      "text": "The employer must advertise the job and consider local candidates fairly before applying, under the Fair Consideration Framework.",
      "who": "employer",
      "blocking": false,
      "sources": [
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/employment-pass/eligibility",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "Employers must continue to meet the Fair Consideration Framework (FCF) job advertising requirement before submitting new EP applications."
        }
      ]
    },
    {
      "id": "compass-40-points",
      "kind": "manual",
      "text": "Unless exempt, the application must score 40 points on COMPASS, a points test that MOM applies to the job and the employer as well as to you.",
      "who": "authority",
      "blocking": false,
      "sources": [
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/employment-pass/eligibility",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "Your application needs to earn 40 points to pass COMPASS."
        }
      ]
    },
    {
      "id": "compass-qualifications",
      "kind": "manual",
      "text": "A degree from a top 100 university in the QS World University Rankings, or another highly reputed university in Asia, earns the most qualification points.",
      "who": "you",
      "blocking": false,
      "sources": [
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/employment-pass/eligibility",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "Top 100 universities based on QS World University Rankings, and other highly-reputed universities in Asia"
        }
      ]
    },
    {
      "id": "compass-diversity",
      "kind": "manual",
      "text": "Ask the employer what share of its professional staff shares your nationality. A small share earns more points, and firms with fewer than 25 such staff get a default score.",
      "who": "employer",
      "blocking": false,
      "sources": [
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/employment-pass/eligibility",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "This criterion awards more points to applications where the candidate’s nationality forms a small share of the firm’s PMET employees."
        },
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/employment-pass/eligibility",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "Fewer than 25 PMETs, your application will score 10 points by default."
        }
      ]
    },
    {
      "id": "compass-exemption",
      "kind": "manual",
      "text": "Jobs with a fixed monthly salary of at least S$22,500 are exempt from COMPASS.",
      "who": "employer",
      "blocking": false,
