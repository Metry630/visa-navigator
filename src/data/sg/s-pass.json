    {
      "id": "fair-consideration",
      "kind": "manual",
      "text": "The employer must advertise the job on MyCareersFuture for at least 14 days and consider all candidates fairly before applying.",
      "who": "employer",
      "blocking": false,
      "sources": [
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/s-pass/consider-all-candidates-fairly",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "To promote fair employment practices and improve labour market transparency, employers submitting S Pass applications must first advertise the job on MyCareersFuture , and consider all candidates fairly."
        },
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/s-pass/consider-all-candidates-fairly",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "The MyCareersFuture job advertisement must be open for at least 14 consecutive days to allow job seekers to view and apply for the vacancy."
        }
      ]
    },
    {
      "id": "quota",
      "kind": "manual",
      "text": "Ask the employer whether it has quota left. S Pass holders are capped at 10% of a services company's workforce and 15% in construction, manufacturing, marine shipyard and process.",
      "who": "employer",
      "blocking": false,
      "sources": [
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/s-pass/quota-and-levy/levy-and-quota-requirements",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "Under the existing quota, the number of S Pass holders your company can hire is capped at: 10% of the company’s total workforce in the services sector. 15% in the construction, manufacturing, marine shipyard and process sectors."
        }
      ]
    },
    {
      "id": "levy",
      "kind": "manual",
      "text": "The employer pays a monthly levy of S$650 for each S Pass holder, at the same rate across all sectors.",
      "who": "employer",
      "blocking": false,
      "sources": [
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/s-pass/quota-and-levy/levy-and-quota-requirements",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-12",
          "quote": "As an employer, you must pay the levy for all your S Pass holders. The levy liability starts from the day the S Pass is issued and ends when the pass is cancelled or expires."
        },
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/s-pass/quota-and-levy/levy-and-quota-requirements",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-12",
          "quote": "Since 1 September 2025 , the S Pass levy rate has been harmonised to $650 across all sectors and levy tiers."
        }
      ]
    },
    {
      "id": "qualifications-optional",
      "kind": "manual",
      "text": "Declaring your qualifications is optional, but if the employer declares them they must be authentic and from an accredited institution.",
      "who": "employer",
      "blocking": false,
      "sources": [
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/s-pass/eligibility",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "Declaring qualifications is optional ."
        },
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/s-pass/eligibility",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "Is authentic Was awarded by an accredited institution in the application form's drop-down list"
        }
      ]
    },
    {
      "id": "self-assessment",
      "kind": "manual",
      "text": "The employer should run MOM's Self-Assessment Tool first, since MOM says an application it marks ineligible will be rejected.",
      "who": "employer",
      "blocking": false,
      "sources": [
        {
          "url": "https://www.mom.gov.sg/passes-and-permits/s-pass/eligibility",
          "publisher": "Ministry of Manpower, Singapore",
          "retrievedOn": "2026-09-11",
          "quote": "If the SAT shows that the candidate is not eligible, you shouldn’t apply for the S Pass because it will be rejected."
        }
      ]
    }
